# Backend / Lambda environment variables (set by template.yaml in AWS; export locally if needed). No secrets belong here.
AWS_REGION=us-east-1
GEOJSON_BUCKET=                # optional: S3 bucket with geojson/*.geojson. Empty = use bundled files
GEOJSON_PREFIX=geojson/
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0   # must be available in AWS_REGION
ENABLE_BEDROCK=false           # true = call Amazon Bedrock for /brief; false = rule-based fallback
ALLOWED_ORIGINS=http://localhost:5173       # enforced by API Gateway CORS (template parameter AllowedOrigins)
LOG_LEVEL=INFO
SIMULATION_VERSION=1.0.0
MAX_SIMULATION_INPUT_SIZE=65536
