# Base URL of the deployed API (no trailing slash). Empty = same-origin (/api/v1/...), use the Vite proxy or local API.
VITE_API_BASE_URL=http://127.0.0.1:8787
# Optional MapLibre style URL. Leave empty to use the bundled offline style with local synthetic data.
VITE_MAP_STYLE_URL=
VITE_APP_VERSION=1.0.0
